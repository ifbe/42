<device>
gpio{
fmt:gpio
arg:/dev/gpiochip0
}
i2chost{
fmt:i2c
arg:/dev/i2c-1
}
</device>


<driver>
ads1115{
fmt:ads1115
adc0:5v
adc1:
adc2:3.7v
adc3:7.4v
}
</driver>


<system>
tcpsrv{
fmt:TCP
arg:``:10000
}
</system>


<artery>
vehicle{
fmt:Vehicle
}
</artery>


<supply>
stdio:std{}
</supply>


<relation>
(@i2chost, dst@0) -> (@ads1115, i2c@0)

(@ads1115, dst@0) -> (@vehicle, volt@0)
(@tcpsrv, dst@0) -> (@vehicle, sock@0)
</relation>
