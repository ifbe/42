<device>
gpio{
fmt:gpio
arg:/dev/gpiochip0
}
i2chost{
fmt:i2c
arg:/dev/i2c-1
}
</device>


<driver>
ads1115{
fmt:ads1115
adc0:5v
adc1:
adc2:3.7v
adc3:7.4v
}
l298n{
fmt:l298n
wheel:omni_o
lfe:22
lfp:4
lfn:27
lne:13
lnp:5
lnn:6
rfe:17
rfp:15
rfn:14
rne:12
rnp:1
rnn:26
}
</driver>


<system>
tcpsrv{
fmt:TCP
arg:``:10000
}
</system>


<artery>
vehicle{
fmt:Vehicle
}
</artery>


<supply>
stdio:std{}
</supply>


<relation>
(@i2chost, dst@0) -> (@ads1115, i2c@0)
(@ads1115, dst@0) -> (@vehicle, volt@0)

(@gpio, dst@0) -> (@l298n, chip@0)
(@l298n, con@0) -> (@vehicle, drv@0)

(@tcpsrv, dst@0) -> (@vehicle, sock@0)

(@stdio, dst) -> (@vehicle, std@0)
</relation>
